; Ordinals verified against the genuine Microsoft XInput9_1_0.dll.
;
; 9.1.0 is a different, smaller surface with its own ordering - it exports only
; these five, and they are NOT numbered the same as in 1.3.
EXPORTS
    DllMain                         @1
    XInputGetCapabilities           @2
    XInputGetDSoundAudioDeviceGuids @3
    XInputGetState                  @4
    XInputSetState                  @5
